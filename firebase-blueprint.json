      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "timeframe": { "type": "string" },
        "entryPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "takeProfit2": { "type": "number" },
        "rrRatio": { "type": "number" },
        "riskPips": { "type": "number" },
        "rewardPips": { "type": "number" },
        "status": { "type": "string" },
        "confluence": { "type": "array", "items": { "type": "string" } },
        "confluenceFactors": { "type": "array" },
        "grade": { "type": "string" },
        "score": { "type": "number" },
        "notes": { "type": "string" },
        "entryReason": { "type": "string" },
